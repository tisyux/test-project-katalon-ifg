<?xml version="1.0" encoding="UTF-8"?>
<GlobalVariableEntities>
   <description>Default profile</description>
   <name>default</name>
   <tag></tag>
   <defaultProfile>true</defaultProfile>
   <GlobalVariableEntity>
      <description>JSONPlaceholder base URL</description>
      <initValue>'https://jsonplaceholder.typicode.com'</initValue>
      <name>baseUrl</name>
   </GlobalVariableEntity>
   <GlobalVariableEntity>
      <description>Post id from create API response</description>
      <initValue>null</initValue>
      <name>createdPostId</name>
   </GlobalVariableEntity>
</GlobalVariableEntities>
